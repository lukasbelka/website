---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { SITE_DATA } from '../constants';

import '../styles/home.css';
---

<Layout pageTitle="">
	<Hero 
		name={SITE_DATA.name} 
		tagline={SITE_DATA.tagline} 
		twitter={SITE_DATA.twitter}
		linkedin={SITE_DATA.linkedin}
		scholar={SITE_DATA.scholar}
		email={SITE_DATA.email}
	/>
	<section>
		<hr class="experience-hr">
        <ul class="custom-list">
               <li>
                	<span class="list-item-title">Reinsurance and primary insurance operations since 2009</span>
                </li>
                <li>
                    <span class="list-item-title">Data Models, piepelines and products since 2020</span>
					<span class="list-item-description">DMC - Data Modeling Certification (since 2023)</span>
                    <span class="list-item-description">Certified Data Analyst Professional (since 2023)</span>
                </li>
                <li>
                    <span class="list-item-title">Agentic AI applied to insurance processes since 2025, realising
						CLI-based agentic co-worker processes. 
					</span>
				</li>
        </ul>
    </section>
	<section>
		<div class="experience-div">
			<h2>Experience</h2>
            <h3>Insurance operating experience</h3>
            <p>Headed the PMO of an international IT transformation programme with 300+ people and a budget of EUR 60m+ at
			   a global industrial P&C carrier. PMO fully supported the transformation of the organisation's classical waterfall
			   project management approach into an agile way of working and established a single delivery cadence across the entire organisation.  
			</p>
    	</div>
		<div class="experience-div">
            <h3>Data Products</h3>
            <p>Created end-to-end data models (generic, logical and physical) and automated pipelines (Snowflake, dbt, SQL/Python
			   and Power Query) for lines of business reporting, financial and budget reporting, as well as for HR staff reporting.
			   Moved from manual and monthly reporting to daily updated dashboards and reports for C-level executives.  
			</p>
    	</div>
		<div class="experience-div">
            <h3>Agentic AI</h3>
            <p>Since 2025 I have been applying agetic AI on general and insurance business processes. Currently I work on an
			   agentic AI skill set for CLI-based agentic co-working streams, like checking submission documents against underwriting
			   guidelines and providing feedback on the submission. The agentic AI skill set is being built model-agnostic and is
			   available via a self-programmed CLI interface. 
			</p>
    	</div>
    </section>
</Layout>
